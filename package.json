{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build --webpack",
    "build:cpanel": "next build --webpack",
    "pack:cpanel": "powershell -ExecutionPolicy Bypass -File ./scripts/pack-cpanel-build.ps1",
    "start": "next start",
