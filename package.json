    "lint": "eslint",
    "test:unit": "node --experimental-strip-types --test ./tests/unit/nationalId.test.ts ./tests/unit/scheduleTime.test.ts ./tests/unit/apiCache.test.ts ./tests/unit/pageFetchPriority.test.ts ./tests/unit/pdfExport.test.ts ./tests/unit/numberInput.test.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "guide:pdf": "node scripts/ui-guide/generate.mjs",
    "guide:demo": "node scripts/ui-guide/run-full.mjs",
    "guides:user": "node scripts/user-guides/generate.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.52.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
